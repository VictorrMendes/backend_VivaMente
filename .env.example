DATABASE_URL=postgresql://vivamente:vivamente@db:5432/vivamente
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

FIREBASE_CREDENTIALS_PATH=.secrets/firebase-service-account.json

# Chave PUBLICA (RS256, formato PEM com \n literais numa linha so) usada
# para validar o JWT de servico da API interna /api/v1/internal/identity/*.
# O Oauth assina com a chave PRIVADA correspondente (BACK_INTERNAL_SERVICE_
# PRIVATE_KEY no .env dele) - o Back nunca guarda a privada, entao mesmo
# comprometido nao forja um token do Oauth. Gere o par com:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
INTERNAL_SERVICE_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nchangeme\n-----END PUBLIC KEY-----
